-- Callback functions
local function onWalkSpeedChange(Value)
    local humanoid = game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.WalkSpeed ~= Value then
        humanoid.WalkSpeed = Value
    end
    print("WalkSpeed:", Value)
end

local function onJumpPowerChange(Value)
    local humanoid = game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid:SetAttribute("JumpPower", Value) -- Store JumpPower as an attribute
        humanoid.UseJumpPower = true
        humanoid.JumpPower = Value
    end
    print("JumpPower:", Value)
end

local function onFOVChange(Value)
    if workspace.CurrentCamera.FieldOfView ~= Value then
        workspace.CurrentCamera.FieldOfView = Value
    end
    print("FOV:", Value)
end

local function onGravityChange(Value)
    if workspace.Gravity ~= Value then
        workspace.Gravity = Value
    end
    print("Gravity:", Value)
end

